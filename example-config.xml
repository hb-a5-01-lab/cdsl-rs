<?xml version="1.0" encoding="UTF-8"?>
<!-- CDSL Hardware and Component Configuration Template -->
<config>
    <!-- Arduino microcontroller serial communication settings -->
    <arduino>
        <!-- Serial device port path (e.g., /dev/ttyUSB0 or COM3) -->
        <port>/dev/ttyUSBX</port>
        <!-- Communication speed in baud (e.g., 9600, 19200, 38400, 57600, 115200) -->
        <baud_rate>123456</baud_rate>
    </arduino>

    <!-- Robotic component definitions and movement limits -->
    <component>
        <!-- First component example -->
        <component_1>
            <!-- Hardware ID sent to the microcontroller (0-255) -->
            <id>0</id>
            <!-- Minimum allowed position (degrees or steps) -->
            <min>0</min>
            <!-- Maximum allowed position (degrees or steps) -->
            <max>180</max>
            <!-- Default position used by the RESET command -->
            <default>90</default>
        </component_1>

        <!-- Second component example -->
        <component_2>
            <id>1</id>
            <min>0</min>
            <max>180</max>
            <default>0</default>
        </component_2>
    </component>
</config>
